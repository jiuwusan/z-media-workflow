# Local server and panel
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000/
WORKFLOW_CALLBACK_URL=http://172.29.0.1:3000/api/webhooks/qbittorrent/completed
NODE_ENV=development
DEV_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
# Administrator login credentials; management APIs use cookie sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: at least 24 chars when webhook authentication is enabled.
WORKFLOW_API_TOKEN=replace-with-a-different-webhook-token
# Internal callback: false accepts completion events without a token.
# Management panel/API authentication remains enabled.
WEBHOOK_AUTH_ENABLED=false
SESSION_TTL_MS=28800000

QBT_URL=https://cloud.jiuwusan.cn:36080/
QBT_API_KEY=replace-me
JELLYFIN_URL=https://cloud.jiuwusan.cn:36443/jellyfin/
JELLYFIN_API_KEY=replace-me
JELLYFIN_SERIES_LIBRARY_ID=8f243a977b16ae6b73de82cfadee0bc5
JELLYFIN_MOVIE_LIBRARY_ID=18c2c541c96e0d36ab416d9eb0618fc3
DEEPSEEK_URL=https://api.deepseek.com/
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash

# Leave both blank when qBittorrent and Jellyfin use the same paths.
QBT_PATH_PREFIX=
JELLYFIN_PATH_PREFIX=
REQUEST_TIMEOUT_MS=15000
POLL_INTERVAL_MS=2000
SCAN_TIMEOUT_MS=600000
VERIFY_TIMEOUT_MS=120000
INGEST_RETRIES=2
MAX_QUEUE=30
MAX_JOBS=200
JOB_TTL_MS=86400000
SHUTDOWN_TIMEOUT_MS=30000

# Docker Compose (container listens on 0.0.0.0:3000).
DOCKER_IMAGE=jiuwusan/z-media-workflow:latest
DOCKER_HOST_PORT=3000
# Set to the externally accessible panel URL; also used to display callback URLs.
DOCKER_PUBLIC_URL=http://localhost:3000/
# Must exceed SHUTDOWN_TIMEOUT_MS, with time for HTTP connection shutdown.
DOCKER_STOP_GRACE_PERIOD=35s
