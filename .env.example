# All application settings and credentials are stored in config.json.
# Copy config.example.json to data/config.json and fill it before starting.
# Existing application .env values are imported once when JSON is absent.
CONFIG_FILE=data/config.json
NODE_ENV=development

# Docker deployment parameters (used by Compose, not application settings).
DOCKER_IMAGE=jiuwusan/z-media-workflow:latest
DOCKER_HOST_PORT=3000
DOCKER_STOP_GRACE_PERIOD=35s
