{
  "name": "z-media-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test/ui.smoke.mjs",
    "check:connections": "node scripts/check-connections.mjs",
    "start:pm2": "pm2-runtime ecosystem.config.cjs",
    "test:pm2": "node --test test/pm2.smoke.mjs"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.0.0",
    "@koa/router": "^15.0.0",
    "koa": "^3.0.0",
    "koa-static": "^5.0.0",
    "pm2": "7.0.4"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "overrides": {
    "pm2": {
      "chokidar": "4.0.3",
      "js-yaml": "4.3.2"
    },
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  }
}
